#!/bin/bash
# Ralph Project Configuration
# Copy this file to your project root as 'ralph.config.sh' and customize for your project

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Git Configuration
# The HTTPS URL for your git remote (e.g., "https://gitlab.zgtools.net/team/project.git")
export RALPH_GIT_REMOTE="https://your-git-host.com/your-team/your-project.git"

# The main branch name (usually "main" or "master")
export RALPH_GIT_MAIN_BRANCH="main"

# Deployment Configuration
# The staging environment URL where changes auto-deploy
export RALPH_STAGING_URL="https://your-app-staging.your-domain.com"

# How long to wait for staging deployment to complete (seconds)
export RALPH_DEPLOY_WAIT_SECONDS=300

# Validation Commands
# Command to validate code locally before committing (linting, type-checking, etc.)
export RALPH_VALIDATE_LOCAL="npm run check"

# Command to run tests against staging environment
# Can reference $RALPH_STAGING_URL if needed
export RALPH_VALIDATE_STAGING="npm test"

# Health check endpoint path (appended to RALPH_STAGING_URL)
export RALPH_HEALTH_CHECK_PATH="/health"

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Environment variables to set when running staging tests
# Example: "STAGING_URL=$RALPH_STAGING_URL API_KEY=test123"
# export RALPH_TEST_ENV_VARS=""

# Task timeout in minutes (default: 15)
# export RALPH_TASK_TIMEOUT_MINUTES=15

# Auto-archive completed sprints (default: true)
# export RALPH_AUTO_ARCHIVE=true

